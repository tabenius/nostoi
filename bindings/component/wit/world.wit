package nostoi:audit@0.1.0;

/// JSON text preserves integers larger than JavaScript's safe integer range.
/// The host owns storage, locking and clocks. No filesystem is exposed.
interface chains {
    record draft {
        at: string,
        actor: option<string>,
        kind: string,
        subject: option<string>,
        body-json: string,
    }
    canonical-json: func(json: string) -> result<string, string>;
    /// Broken chains return a JSON report with ok=false, not an API error.
    verify-jsonl: func(jsonl: string, format: option<string>) -> result<string, string>;
    /// Returns the entire extended chain. Refuses to extend broken chains.
    append-jsonl: func(jsonl: string, entry: draft) -> result<string, string>;
}

/// The portable half of an attestation: what was signed, and whether it is still
/// true of a chain. No signature checking and no `ssh-keygen` — a signature needs
/// a key, and this interface deliberately has nowhere to put one.
interface attestations {
    /// The exact bytes a document's signature covers, in ASCII.
    canonical-bytes: func(document: string) -> result<string, string>;
    /// Check a document against a chain the host supplies as JSONL text.
    /// Returns a JSON report; "stale" is a finding, not an error.
    verify-document: func(jsonl: string, document: string, format: option<string>)
        -> result<string, string>;
}

world audit {
    export chains;
    export attestations;
}
