# Nonsecret configuration for a multi-destination publish:
#   /etc/nostoi/anchor/kernel.env
# See docs/ANCHOR-FANOUT.md. Single-destination variables (ENDPOINT, BUCKET,
# REGION, LOCK, RETAIN_DAYS) are refused when TARGETS is set, so a half-migrated
# unit fails instead of publishing to one place.
CHAIN=/var/lib/nostoi/kernel.sqlite
CHAIN_ID=production/kernel
# Destinations, each with its own bucket, credentials and retention.
TARGETS=/etc/nostoi/anchors.json
# Must be inside the instance's writable StateDirectory; one outbox per
# destination is created as <name>.sqlite here.
OUTBOX_DIR=/var/lib/nostoi-anchor/kernel/outbox
# Per-destination retention lives in the target file, not here.
# Secrets belong in LoadCredential files named <credentials>-aws-access-key-id,
# <credentials>-aws-secret-access-key and an optional
# <credentials>-aws-session-token; a destination naming a "credentials" field
# never falls back to the unprefixed files.
