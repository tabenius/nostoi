# Nonsecret configuration for instance kernel: /etc/nostoi/anchor/kernel.env
CHAIN=/var/lib/nostoi/kernel.sqlite
CHAIN_ID=production/kernel
ENDPOINT=https://s3.us-west-2.amazonaws.com
BUCKET=example-audit-checkpoints
REGION=us-west-2
# Must be inside the instance's writable StateDirectory.
OUTBOX=/var/lib/nostoi-anchor/kernel/outbox
# Optional; only for a preconfigured S3 Object Lock bucket, not R2.
# LOCK=compliance
# RETAIN_DAYS=365
# Secrets belong in LoadCredential files, not here.
