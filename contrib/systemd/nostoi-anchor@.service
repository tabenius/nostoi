[Unit]
Description=Publish Nostoi checkpoint (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Operator-created unprivileged account and source-read group; customize locally.
User=nostoi-publisher
Group=nostoi-readers
EnvironmentFile=/etc/nostoi/anchor/%i.env
LoadCredential=aws-access-key-id:/etc/nostoi/credentials/anchor-%i/aws-access-key-id
LoadCredential=aws-secret-access-key:/etc/nostoi/credentials/anchor-%i/aws-secret-access-key
LoadCredential=aws-session-token:/etc/nostoi/credentials/anchor-%i/aws-session-token
ExecStart=/usr/local/libexec/nostoi-anchor-runner publish
StateDirectory=nostoi-anchor/%i
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=10min
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nostoi-anchor/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# All nonzero exits, including unknown (2) and unconfirmed (3), are failures.
