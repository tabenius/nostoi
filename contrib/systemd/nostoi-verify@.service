[Unit]
Description=Verify Nostoi history against independently trusted checkpoint (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A different operator-created account; no publisher outbox access is needed.
User=nostoi-verifier
Group=nostoi-readers
EnvironmentFile=/etc/nostoi/verify/%i.env
LoadCredential=aws-access-key-id:/etc/nostoi/credentials/verify-%i/aws-access-key-id
LoadCredential=aws-secret-access-key:/etc/nostoi/credentials/verify-%i/aws-secret-access-key
LoadCredential=aws-session-token:/etc/nostoi/credentials/verify-%i/aws-session-token
ExecStart=/usr/local/libexec/nostoi-anchor-runner verify
UMask=0077
TimeoutStartSec=10min
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
