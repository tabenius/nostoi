# Independently managed configuration: /etc/nostoi/verify/kernel.env
CHAIN=/var/lib/nostoi/kernel.sqlite
CHAIN_ID=production/kernel
ENDPOINT=https://s3.us-west-2.amazonaws.com
BUCKET=example-audit-checkpoints
REGION=us-west-2
# Replace with an actual independently accepted checkpoint key before running.
TRUSTED_KEY=heads/REPLACE_WITH_INDEPENDENTLY_TRUSTED_CHECKPOINT.json
# No OUTBOX, LOCK or RETAIN_DAYS. No secrets in this file.
